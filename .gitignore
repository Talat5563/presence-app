# --- Gradle / Kotlin Multiplatform ---
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar
local.properties
captures/
.kotlin/
kotlin-js-store/

# --- Android ---
*.apk
*.aab
*.ap_
*.dex
*.class
bin/
gen/
out/
release/
.cxx/
*.keystore
!debug.keystore
google-services.json

# --- IntelliJ / Android Studio ---
.idea/
*.iml
*.iws
*.ipr
.navigation/

# --- Xcode / iOS ---
xcuserdata/
*.xcuserstate
*.xcscmblueprint
DerivedData/
*.hmap
*.ipa
*.dSYM.zip
*.dSYM
Pods/
