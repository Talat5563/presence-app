# --- macOS / Windows ---
.DS_Store
Thumbs.db
Desktop.ini

# --- ML models (large binaries; fetched by script, not committed) ---
*.onnx
*.tflite
models/*.bin

# --- Privacy: never commit real voice data ---
# Enrollment audio and derived voice profiles must never enter version control.
*.wav
*.m4a
*.aac
*.mp3
*.flac
*.ogg
*.opus
*.mp4
*.mov
*.webm

# --- Corpora and evaluation output ---
# Third-party corpora (e.g. CHILDES, CC BY-NC-SA) may be used for evaluation but never
# redistributed, and reports quote real recordings' paths and timings.
data/
corpora/
reports/
**/voice-profiles/
**/enrollment-audio/
!src/**/test/resources/fixtures/*.wav

# --- Local env ---
.env
.env.local

# Design drop archives — contents are extracted and tracked alongside
docs/design/*.zip
__pycache__/
.venv/
